{
  "name": "netinventors/shopware6-psalm-stubs",
  "description": "Psalm stub files for Shopware 6",
  "license": "MPL-2.0",
  "authors": [
    {
      "name": "Net Inventors GmbH",
      "email": "info@netinventors.de",
      "role": "Manufacturer"
    }
  ],
  "config": {
    "allow-plugins": {
      "symfony/runtime": false,
      "php-http/discovery": false
    },
    "audit": {
      "block-insecure": false
    },
    "sort-packages": true
  },
  "require": {
    "php": ">=8.2",
    "ext-simplexml": "*",
    "symfony/finder": "^7.3",
    "vimeo/psalm": "^6.12",
    "composer/semver": "^3.4",
    "composer-runtime-api": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "NetInventors\\Shopware6PsalmStubs\\": "src/"
    }
  },
  "require-dev": {
    "nikic/php-parser": "^5.0",
    "phpunit/phpunit": "^12.0",
    "shopware/core": "~6.7.0"
  },
  "autoload-dev": {
    "psr-4": {
      "NetInventors\\Shopware6PsalmStubs\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "10.x-dev"
    }
  },
  "scripts": {
    "test": "phpunit",
    "signatures:check": "php bin/stub-signatures check",
    "signatures:update": "php bin/stub-signatures update"
  }
}
